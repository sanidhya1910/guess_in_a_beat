# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music API credentials (developer token)
# Requires a paid Apple Developer Program membership ($99/yr).
# Create a MusicKit key at https://developer.apple.com/account/resources/authkeys/list
# APPLE_PRIVATE_KEY is the .p8 file contents with real newlines replaced by \n
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_musickit_key_id_here
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENTS\n-----END PRIVATE KEY-----"
